# Microsoft TTS keeps its protocol defaults; all overrides are optional.
# WXT_EDGE_TTS_HTTP_ENABLED=true
# WXT_EDGE_TTS_TRUSTED_CLIENT_TOKEN=
# WXT_EDGE_TTS_SIGNATURE_SECRET_BASE64=
# WXT_EDGE_TTS_SIGNATURE_APP_ID=
# Development only: alias definitions/layout-engine from a local monorepo checkout.
# WXT_USE_LOCAL_PACKAGES=false
# WXT_MONOREPO_PATH=
